<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="my_robot_ros2_control"
               params="bus_config master_config can_interface:=can0">

    <ros2_control name="MyRobotCanopenSystem" type="system">

      <hardware>
        <plugin>my_dual_axis_driver/DualAxisSystem</plugin>
        <param name="bus_config">${bus_config}</param>
        <param name="master_config">${master_config}</param>
        <param name="can_interface_name">${can_interface}</param>
      </hardware>

      <!-- 축 0 = 0x6000 (오른쪽) -->
      <joint name="wheel_right_joint">
        <param name="node_id">1</param>
        <param name="axis">0</param>
        <param name="wheel_radius">0.0325</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- 축 1 = 0x6800 (왼쪽) -->
      <joint name="wheel_left_joint">
        <param name="node_id">1</param>
        <param name="axis">1</param>
        <param name="wheel_radius">0.0325</param>
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
